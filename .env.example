# =========================================================
# VARIABLES D'ENVIRONNEMENT DU HUB
#
# Copie de référence, SANS AUCUNE VALEUR RÉELLE. Les vraies
# valeurs vivent sur Vercel (Settings → Environment
# Variables) et nulle part ailleurs — surtout pas ici.
#
# Rappel qui a coûté une soirée : une variable modifiée sur
# Vercel ne s'applique PAS au déploiement en ligne. Il faut
# relancer un déploiement.
# =========================================================

# --- Stockage. Partagé par le solaire, le profil et les
# --- rappels. Onglet ".env" du tableau de bord Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Onduleur Fronius. Clé attendue par /api/solar/ingest.
SOLAR_INGEST_KEY=
# Mettre à 1 pour conserver la charge utile brute de
# l'onduleur, lisible ensuite via ?debug=powerflow.
SOLAR_KEEP_RAW=

# --- Notifications. Paire VAPID générée pour CETTE
# --- installation. La privée est un vrai secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton@adresse.fr

# --- Planification des rappels.
QSTASH_TOKEN=
# OBLIGATOIRE hors Europe : chaque compte QStash vit dans une
# région, et le jeton n'est reconnu que par le serveur de
# celle-ci. L'adresse par défaut est européenne ; un compte
# américain répond "user not found in this region".
QSTASH_URL=https://qstash-us-east-1.upstash.io

# --- Facultatif.
APP_URL=
REMINDER_SECRET=
HUB_TIMEZONE=Europe/Paris

# --- Sondes de diagnostic.
# Sans cette clé, AUCUNE sonde ne répond — c'est voulu.
# Avec elle, ajouter ?key=<la clé> à l'adresse d'une sonde.
DEBUG_KEY=
